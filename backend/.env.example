ADDR=:8080
DATABASE_URL=postgres://fantasm:fantasm@localhost:5432/fantasm?sslmode=disable
MIGRATIONS_DIR=migrations
MIGRATE_ON_START=false
PUBLIC_URL=http://localhost:5173
ORGANIZATION_RULES_FILE=/app/config/organizations.json

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Signs pagination cursors and keys the client-address hash. Required (32+ chars) when PUBLIC_URL is https;
# over http a random one is made at start, so cursors do not survive a restart.
APP_SECRET=
LOG_LEVEL=info

# Comma-separated networks whose X-Forwarded-For is trusted (the reverse proxy). Empty = never trust it.
TRUSTED_PROXY_CIDRS=

# Rate limits: requests per second and burst, per address (anonymous) or per user (signed in).
RATE_LIMIT_ANON_RPS=10
RATE_LIMIT_ANON_BURST=40
RATE_LIMIT_USER_RPS=20
RATE_LIMIT_USER_BURST=60
# Sign-in attempts per minute per address, and posts / reports per minute per user.
RATE_LIMIT_LOGIN_PER_MIN=20
RATE_LIMIT_POSTS_PER_MIN=10

# Sessions: a session ends after the idle time without use, or the absolute time in any case.
SESSION_IDLE_TTL=168h
SESSION_ABSOLUTE_TTL=720h

DB_MAX_CONNS=20
DB_STATEMENT_TIMEOUT=10s
REQUEST_TIMEOUT=15s
SHUTDOWN_TIMEOUT=20s

# Empty disables the private Prometheus listener. Use 127.0.0.1:9091 outside Docker.
METRICS_ADDR=
