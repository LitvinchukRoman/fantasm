      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(fantasm_http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "",
          "range": true
        }
      ]
    },
